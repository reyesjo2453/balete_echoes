 "recap": [
  {
   "text": "1998. Lolo Pido turned a flood back for four minutes and seventeen seconds. Downriver, the water drowned thirty-one people.",
   "if": "seen_co_downriver"
  },
  {
   "text": "At Mang Berto's wake, you nodded at a dead man. He nodded back.",
   "if": "ghost_nod"
  },
  {
   "text": "At Mang Berto's wake, you pretended not to see a dead man. He saw you anyway.",
   "if": "ignored_ghost"
  },
  {
   "text": "You promised Kapitan Obet the money by Friday.",
   "if": "obet_promise"
  },
  {
   "text": "You threw Kapitan Obet out of a wake.",
   "if": "obet_out"
  },
  {
   "text": "Kapitan Obet came to collect. You poured his coffee and said nothing.",
   "if": "obet_quiet"
  },
  {
   "text": "Mang Berto's last fare wore a Hiraya Energy jacket.",
   "if": "clue_hiraya"
  },
  {
   "text": "You promised Mang Berto you'd tell his wife about the money in the cushion.",
   "if": "promise_berto"
  },
  {
   "text": "You told Mang Berto it wasn't your job.",
   "if": "refused_berto"
  },
  {
   "text": "Lola Ising gave you Lolo Pido's watch. It ticked for you.",
   "if": "bearer_teo",
   "unless": "watch_catch_miss"
  },
  {
   "text": "Lola Ising gave you Lolo Pido's watch. You dropped it, and the crystal cracked. It ticked for you anyway.",
   "if": "watch_catch_miss"
  },
  {
   "text": "You sent Mang Berto home on Magwayen's boat.",
   "if": "seen_hatid"
  },
  {
   "text": "Lola told you what the watch is: it borrows time, and writes every second against the family.",
   "if": "ask_watch"
  },
  {
   "text": "Lola told you why she was leaving: to lead the people hunting the watch away from you.",
   "if": "ask_leaving"
  },
  {
   "text": "Lola told you Lolo's four minutes cost him ten years.",
   "if": "ask_lolo"
  },
  {
   "text": "You pointed the watch at Lola. It showed 2:40. Tonight.",
   "if": "seen_act1_hook"
  },
  {
   "text": "You laid a salt line across the door, and went to the water.",
   "if": "salt_door"
  },
  {
   "text": "You left the door open so you'd hear her call, and went to the water.",
   "if": "open_door"
  },
  {
   "text": "Aling Tess's son went into the estero three weeks ago. Hiraya never gave her a body.",
   "if": "heard_tess"
  },
  {
   "text": "Kapitan Obet signed the permit for Hiraya's pump on the estero.",
   "if": "obet_permit"
  },
  {
   "text": "A white van comes for Hiraya's tanks every night at two.",
   "if": "van_schedule"
  },
  {
   "text": "You sent home Mang Ambo Salonga, a sundô borrowed down to nothing.",
   "if": "ambo_sent"
  },
  {
   "text": "You took Mang Ambo Salonga's ledger. Its last line: DIMACULANGAN. BEING COLLECTED.",
   "if": "ledger_taken"
  },
  {
   "text": "The aswang killed you. The watch turned it back, and left a white streak in your hair.",
   "if": "watch_awake"
  },
  {
   "text": "You kept the aswang's Hiraya tag.",
   "if": "has_tag"
  },
  {
   "text": "Kardo rammed the gate. You chose Lola over the van, and got home one minute late.",
   "if": "went_home"
  },
  {
   "text": "Kardo rammed the gate. You chased the van, and saw a woman with a white streak like yours.",
   "if": "chased_van"
  },
  {
   "text": "Hiraya took Lola Ising. Where her time was, the dial is blank.",
   "if": "seen_parlor_taken"
  },
  {
   "text": "Kardo told you the truth: the water Lolo pushed away drowned a boy's father. The boy was Gregorio Villacorta.",
   "if": "seen_kardo_1998"
  },
  {
   "text": "Lola's tape: the bus to Vigan was a decoy, meant to lead them away from you.",
   "if": "seen_tape"
  },
  {
   "text": "Hiraya offered Lola, the house and the debt for the watch. You refused.",
   "if": "offer_refused"
  },
  {
   "text": "Hiraya offered Lola, the house and the debt for the watch. You asked for proof.",
   "if": "offer_stalled"
  },
  {
   "text": "Hiraya offered Lola, the house and the debt for the watch. You said yes.",
   "if": "offer_yes"
  },
  {
   "text": "Inside the Hiraya hound, a soul in a bottle. You set it free.",
   "if": "vial_freed"
  },
  {
   "text": "Inside the Hiraya hound, a soul in a bottle. You kept it as proof.",
   "if": "vial_kept"
  },
  {
   "text": "Kapitan Obet admitted he sold Lola's debt to Hiraya.",
   "if": "seen_dawn"
  }
 ]
}